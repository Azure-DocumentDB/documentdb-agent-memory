{
  "name": "vercel-ai-memory-documentdb",
  "version": "0.1.0",
  "description": "Application-level AI SDK message memory backed by Azure DocumentDB",
  "license": "MIT",
  "author": "Azure DocumentDB",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vercel-ai-sdk",
    "documentdb",
    "azure",
    "agent",
    "memory",
    "vector-search"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Azure-DocumentDB/documentdb-agent-memory.git",
    "directory": "packages/vercel-ai-memory-documentdb"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/test/*.test.js",
    "test:live": "npm run build && tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/test/live.js"
  },
  "dependencies": {
    "ai": "7.0.138",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@azure/identity": "4.13.3"
  }
}
